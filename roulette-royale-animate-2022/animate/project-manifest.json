      "asset": "assets/svg/chip_10.svg",
      "registration": "center"
    },
    {
      "name": "Chip_50",
      "type": "MovieClip",
      "asset": "assets/svg/chip_50.svg",
      "registration": "center"
    },
    {
      "name": "Chip_100",
      "type": "MovieClip",
      "asset": "assets/svg/chip_100.svg",
      "registration": "center"
    },
    {
      "name": "Chip_500",
      "type": "MovieClip",
      "asset": "assets/svg/chip_500.svg",
      "registration": "center"
    },
    {
      "name": "Popup_Settings",
      "type": "MovieClip"
    },
    {
      "name": "Popup_Information",
      "type": "MovieClip"
    },
    {
      "name": "Popup_Exit",
      "type": "MovieClip"
    }
  ],
  "gameRules": {
    "wheel": "European single-zero",
    "numbers": "0-36",
    "startingBalance": 1000,
    "chips": [10, 50, 100, 500],
    "supportedBets": ["single", "red", "black", "even", "odd", "low", "high"],
    "payouts": {
      "single": "35:1",
      "red": "1:1",
      "black": "1:1",
      "even": "1:1",
      "odd": "1:1",
      "low": "1:1",
      "high": "1:1"
    }
  }
}
